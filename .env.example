# Required secrets. Generate two different values before starting Docker Compose.
# OpenSSL: openssl rand -hex 32
# Python:  python3 -c "import secrets; print(secrets.token_hex(32))"
# Paste one generated value for each setting. Empty values make Compose stop safely.
POSTGRES_PASSWORD=
GOPEED_API_TOKEN=

# Optional network and internal service topology. Keep these defaults for a standard deployment.
CLOUDREVO_PORT=5212
CLOUDREVO_DB_TYPE=postgres
CLOUDREVO_DB_HOST=postgresql
CLOUDREVO_DB_PORT=5432
CLOUDREVO_DB_USER=cloudrevo
CLOUDREVO_DB_NAME=cloudrevo
CLOUDREVO_REDIS_SERVER=redis:6379

# Optional media-processing defaults for the CloudRevo container.
CR_SETTING_DEFAULT_thumb_ffmpeg_enabled=1
CR_SETTING_DEFAULT_thumb_vips_enabled=1
CR_SETTING_DEFAULT_thumb_libreoffice_enabled=1
CR_SETTING_DEFAULT_media_meta_ffprobe=1
CR_SETTING_DEFAULT_thumb_libraw_enabled=1
